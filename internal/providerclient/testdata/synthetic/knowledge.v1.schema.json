              },
              "treeSHA256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 71,
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "contractSHA256": {
                "type": "string",
                "minLength": 1,
