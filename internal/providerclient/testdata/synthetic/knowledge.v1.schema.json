  "$defs": {
    "inputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "contextFloor",
        "definitions"
      ],
      "properties": {
        "apiVersion": {
          "const": "tplaiter.dev/knowledge-inputs/v1"
        },
        "contextFloor": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140,
            "pattern": "^[a-z][a-z0-9.-]{0,63}:(block|skill|resource|source|catalog|owner|executor|quality):[a-z][a-z0-9._-]{0,63}$"
          }
        },
        "definitions": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
