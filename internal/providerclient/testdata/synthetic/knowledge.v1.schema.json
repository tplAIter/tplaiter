              "domain",
              "name",
              "version",
              "contentDigest",
              "parameters",
              "toolDigest",
              "requires"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
              },
              "domain": {
                "enum": [
                  "block",
                  "skill",
                  "approach",
                  "package"
