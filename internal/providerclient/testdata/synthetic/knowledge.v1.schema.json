                      "maxLength": 128,
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
                    },
                    "value": {
                      "oneOf": [
                        {
                          "type": "string",
                          "maxLength": 4096
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
