              },
              "nullable": {
                "type": "boolean"
              },
              "default": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 4096
                  },
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "constraints": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {
                  "minLength": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4096
                  },
                  "maxLength": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4096
                  },
                  "pattern": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "minimum": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "maximum": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "enum": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "uniqueItems": true,
                    "items": {
                      "oneOf": [
                        {
                          "type": "string",
                          "maxLength": 4096
                        },
                        {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "string"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "default": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "constraints": {
                      "not": {
                        "anyOf": [
                          {
                            "required": [
                              "minimum"
                            ]
                          },
                          {
                            "required": [
