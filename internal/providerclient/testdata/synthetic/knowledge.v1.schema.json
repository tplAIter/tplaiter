              },
              "dependencies": {
                "type": "array",
                "minItems": 0,
                "maxItems": 128,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "commitAlgorithm": {
                      "const": "sha1"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "commit": {
                      "pattern": "^[0-9a-f]{40}$"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "commit": {
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              }
            ]
          },
          "anchor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "origin",
              "templatePath",
              "requestedRef",
              "commit",
              "treeSHA256",
              "contractSHA256",
              "statementCAS",
              "signatureCAS",
              "keyFingerprint",
              "checkpointCAS",
              "inclusionProofCAS"
