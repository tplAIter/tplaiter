{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tplaiter.dev/schema/knowledge.v1.schema.json",
  "title": "KnowledgeCatalog v1 \u2014 data only",
  "description": "Closed portable descriptor. Structural pins and declared/static/unresolved metadata grant no execution, approval, ownership or trust authority. Core additionally validates existing source/export contracts, reference closure and byte bounds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "id",
    "version",
    "sources",
    "items",
    "edges"
  ],
  "properties": {
    "apiVersion": {
      "const": "tplaiter.dev/knowledge/v1"
    },
    "kind": {
      "const": "KnowledgeCatalog"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140,
      "pattern": "^[a-z][a-z0-9.-]{0,63}:catalog:[a-z][a-z0-9._-]{0,63}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "pin",
          "anchor"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140,
            "pattern": "^[a-z][a-z0-9.-]{0,63}:source:[a-z][a-z0-9._-]{0,63}$"
          },
          "pin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "apiVersion",
              "alias",
              "providerID",
              "origin",
              "templatePath",
              "requestedRef",
              "commitAlgorithm",
              "commit",
              "treeDigest",
              "contentDigest",
              "contractDigest",
              "evidenceDigest",
              "parameters",
              "dependencies"
            ],
            "properties": {
