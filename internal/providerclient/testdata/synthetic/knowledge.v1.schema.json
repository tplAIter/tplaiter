          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140,
            "pattern": "^[a-z][a-z0-9.-]{0,63}:(block|skill|resource|source|catalog|owner|executor|quality):[a-z][a-z0-9._-]{0,63}$"
