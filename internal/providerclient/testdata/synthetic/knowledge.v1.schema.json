              "commit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
              },
              "treeDigest": {
                "type": "string",
                "minLength": 1,
                "maxLength": 71,
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "contentDigest": {
                "type": "string",
                "minLength": 1,
                "maxLength": 71,
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "contractDigest": {
                "type": "string",
                "minLength": 1,
                "maxLength": 71,
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "evidenceDigest": {
