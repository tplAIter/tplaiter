# Example project template file (rendered by text/template + tplater markers).
project={{ .Project.Slug }}
module={{ .Project.Module }}
variant={{ .Settings.variant }}
port={{ .Runtime.Port }}

# In-file one-line marker: the line remains only when feature_x=true.
feature_x=on // tplater:if feature_x=true

# Block begin/end marker: the entire block remains only when variant=advanced.
// tplater:begin variant=advanced
advanced_mode=enabled
verbose={{ .Settings.verbose }}
// tplater:end
