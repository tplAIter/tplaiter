package lintrules

import "context"

// DoWork — exported function with ctx as its first parameter: satisfies
// ctx-first.
func DoWork(ctx context.Context, id string) error {
	_ = ctx
	_ = id
	return nil
}

// NoParams — exported function without parameters: ctx-first skips it.
func NoParams() {
}

// Worker — type with an exported method accepting ctx first.
type Worker struct{}

// NewWorker — constructor excluded from ctx-first by the New prefix.
func NewWorker() *Worker {
	return &Worker{}
}

// Run — method with a receiver and ctx as its first parameter — valid.
func (w *Worker) Run(ctx context.Context, opts ...string) error {
	_ = ctx
	_ = opts
	return nil
}

// helper — unexported function without ctx: the rule does not apply to it.
func helper() int {
	return 1
}
