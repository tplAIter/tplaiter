package lintrules

import "context"

{{ if .Settings.violations }}
// Process — нарушение ctx-first: первый параметр не context.Context (ctx —
// второй).
func Process(id string, ctx context.Context) error {
	_ = id
	_ = ctx
	return nil
}

// init — нарушение no-init: запрещён в этом пути (domain/usecase-аналог).
func init() {
	_ = 1
}

// RunBatch — нарушение no-panic: panic() вне main/init.
func RunBatch() {
	panic("boom")
}
{{ else }}
// Process — экспортируемая функция без нарушений: ctx первым параметром.
func Process(ctx context.Context, id string) error {
	_ = ctx
	_ = id
	return nil
}

// RunBatch — экспортируемая функция без panic.
func RunBatch() {
	_ = 1
}
{{ end }}
