package lintrules

import "context"

{{ if .Settings.violations }}
// Process — ctx-first violation: the first parameter is not context.Context
// (ctx is second).
func Process(id string, ctx context.Context) error {
	_ = id
	_ = ctx
	return nil
}

// init — no-init violation: forbidden in this path (domain/usecase analogue).
func init() {
	_ = 1
}

// RunBatch — no-panic violation: panic() outside main/init.
func RunBatch() {
	panic("boom")
}
{{ else }}
// Process — exported function without violations: ctx is the first parameter.
func Process(ctx context.Context, id string) error {
	_ = ctx
	_ = id
	return nil
}

// RunBatch — exported function without panic.
func RunBatch() {
	_ = 1
}
{{ end }}
