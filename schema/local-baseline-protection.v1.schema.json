{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tplaiter.dev/schema/local-baseline-protection.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "reason"
  ],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "enum": [
        "user-owned",
        "tombstone",
        "skipIfExists"
      ]
    }
  }
}
