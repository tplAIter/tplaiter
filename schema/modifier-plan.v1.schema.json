{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tplaiter.dev/schema/modifier-plan.v1.schema.json",
  "title": "Pure modifier plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "id", "records"],
  "properties": {
    "apiVersion": {"const": "tplaiter.dev/modifier-plan/v1"},
    "kind": {"const": "ModifierPlan"},
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "value": {"type": "object", "additionalProperties": false, "required": ["present", "value"], "properties": {"present": {"type": "boolean"}, "value": {"type": "string", "maxLength": 65536}}},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "parentOriginal", "parentAfter", "target", "pointer", "op", "expectedPresence", "expectedValue", "successorSelector", "before", "after"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
        "source": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"},
        "parentOriginal": {"oneOf": [{"type": "null"}, {"type": "object"}]},
        "parentAfter": {"oneOf": [{"type": "null"}, {"type": "object"}]},
        "target": {"type": "string", "pattern": "^[^/\\\\:]+(?:/[^/\\\\:]+)*$", "maxLength": 4096},
        "pointer": {"type": "string", "maxLength": 512},
        "op": {"enum": ["add", "replace", "remove", "keep", "compose", "retire", "replace-definition", "replace-active-association", "string-slots"]},
        "expectedPresence": {"type": "boolean"},
        "expectedValue": {"type": "string", "maxLength": 65536},
        "successorSelector": {"type": "string", "maxLength": 512},
        "before": {"$ref": "#/$defs/value"},
        "after": {"$ref": "#/$defs/value"}
      }
    }
  }
}
