{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tplaiter.dev/project/v2",
  "title": "tplaiter project marker (project/v2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "id", "template", "project", "answers", "state"],
  "properties": {
    "apiVersion": {"const": "tplaiter.dev/project/v2"},
    "kind": {"const": "Project"},
    "id": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "name", "requestedRef", "resolvedCommit"],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "requestedRef": {"type": "string", "minLength": 1},
        "resolvedCommit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"}
      }
    },
    "project": {"type": "object"},
    "answers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "source"],
        "properties": {
          "value": {},
          "source": {"enum": ["legacy", "user", "default", "migration"]}
        }
      }
    },
    "runtime": {"type": "object"},
    "ownership": {
      "type": "object",
      "properties": {
        "nativeAdoption": {"$ref": "#/$defs/nativeAdoption"}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootLock", "dependencyLock", "baseline", "ownership", "resources", "aiManaged", "generatorTargets", "managedBlocks", "migrations"],
      "properties": {
        "rootLock": {"const": ".tplaiter/root-template.lock.json"},
        "dependencyLock": {"const": ".tplaiter/template.lock.json"},
        "baseline": {"const": ".tplaiter/baseline.json"},
        "ownership": {"const": ".tplaiter/ownership.json"},
        "resources": {"const": ".tplaiter/resources.lock.json"},
        "aiManaged": {"const": ".tplaiter/ai-managed.json"},
        "generatorTargets": {"const": ".tplaiter/generator-targets.lock.json"},
        "managedBlocks": {"const": ".tplaiter/managed-blocks.json"},
        "migrations": {"const": ".tplaiter/migrations.json"}
      }
    }
  },
  "$defs": {
    "adoptionDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nativeAdoption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "decisionSHA256", "origin"],
      "properties": {
        "version": {"const": 1},
        "decisionSHA256": {"$ref": "#/$defs/adoptionDigest"},
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["projectID", "profileBinding", "sourceRootLockSHA256", "sourceCommit", "rendererVersion", "renderInputsSHA256", "decisionAt", "exclusions"],
          "properties": {
            "projectID": {"type": "string", "minLength": 1},
            "profileBinding": {"$ref": "#/$defs/adoptionProfileBinding"},
            "sourceRootLockSHA256": {"$ref": "#/$defs/adoptionDigest"},
            "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "rendererVersion": {"type": "string", "minLength": 1},
            "renderInputsSHA256": {"$ref": "#/$defs/adoptionDigest"},
            "decisionAt": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"},
            "exclusions": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/adoptionExclusion"}}
          }
        }
      }
    },
    "adoptionProfileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "id", "definitionVersion", "configSHA256", "policySHA256", "authoritySHA256", "assurance", "evidenceClass"],
      "properties": {
        "apiVersion": {"const": "tplaiter.dev/trust-profile-binding/v1"},
        "id": {"enum": ["oss", "development", "organization"]},
        "definitionVersion": {"const": 1},
        "configSHA256": {"$ref": "#/$defs/adoptionDigest"},
        "policySHA256": {"$ref": "#/$defs/adoptionDigest"},
        "authoritySHA256": {"$ref": "#/$defs/adoptionDigest"},
        "assurance": {"enum": ["publisher-verified", "development-unverified", "organization-protected"]},
        "evidenceClass": {"enum": ["production", "simulated"]}
      },
      "allOf": [
        {"if": {"properties": {"id": {"const": "oss"}}}, "then": {"properties": {"assurance": {"const": "publisher-verified"}}}},
        {"if": {"properties": {"id": {"const": "development"}}}, "then": {"properties": {"assurance": {"const": "development-unverified"}}}},
        {"if": {"properties": {"id": {"const": "organization"}}}, "then": {"properties": {"assurance": {"const": "organization-protected"}, "evidenceClass": {"const": "production"}}}}
      ]
    },
    "adoptionExclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sourceSHA256", "sourceMode", "initialState", "observed"],
      "properties": {
        "path": {
          "type": "string", "minLength": 1, "maxLength": 1024,
          "pattern": "^[^/\\\\\u0000\r\n:*?\\[\\]#]+(/[^/\\\\\u0000\r\n:*?\\[\\]#]+)*$",
          "allOf": [
            {"not": {"pattern": "(^|/)\\.\\.?($|/)"}},
            {"not": {"pattern": "^\\.(tplaiter|tplater|globals)($|/)"}}
          ]
        },
        "sourceSHA256": {"$ref": "#/$defs/adoptionDigest"},
        "sourceMode": {"const": 420},
        "initialState": {"enum": ["modified", "missing"]},
        "observed": {
          "type": "object", "additionalProperties": false,
          "required": ["exists", "directory", "mode", "device", "inode", "sha256"],
          "properties": {
            "exists": {"type": "boolean"}, "directory": {"const": false},
            "mode": {"type": "integer", "minimum": 0, "maximum": 511},
            "device": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "inode": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "sha256": {"$ref": "#/$defs/adoptionDigest"}
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"initialState": {"const": "modified"}}}, "then": {"properties": {"observed": {"properties": {"exists": {"const": true}, "inode": {"minimum": 1}}}}}},
        {"if": {"properties": {"initialState": {"const": "missing"}}}, "then": {"properties": {"observed": {"properties": {"exists": {"const": false}, "mode": {"const": 0}, "device": {"const": 0}, "inode": {"const": 0}, "sha256": {"const": "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}}}}}}
      ]
    }
  }
}
