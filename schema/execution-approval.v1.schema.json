{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tplaiter.dev/schema/execution-approval.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "requestSHA256",
    "profileBindingSHA256",
    "operationInputsSHA256",
    "projectID",
    "scope",
    "approverID",
    "identityClass",
    "executionPolicySHA256",
    "validity",
    "keyFingerprint",
    "grantSHA256",
    "signatureCAS"
  ],
  "properties": {
    "apiVersion": {
      "const": "tplaiter.dev/execution-approval/v1"
    },
    "kind": {
      "const": "persistent-signed"
    },
    "requestSHA256": {
      "$ref": "#/$defs/digest"
    },
    "profileBindingSHA256": {
      "$ref": "#/$defs/digest"
    },
    "operationInputsSHA256": {
      "$ref": "#/$defs/digest"
    },
    "projectID": {
      "$ref": "#/$defs/token"
    },
    "scope": {
      "enum": [
        "new",
        "link",
        "update",
        "run",
        "gen",
        "tool-install",
        "migration"
      ]
    },
    "approverID": {
      "$ref": "#/$defs/token"
    },
    "identityClass": {
      "enum": [
        "operator",
        "automation"
      ]
    },
    "executionPolicySHA256": {
      "$ref": "#/$defs/digest"
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notBefore",
        "notAfter"
      ],
      "properties": {
        "notBefore": {
          "type": "string",
          "allOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            {
              "format": "date-time"
            }
          ]
        },
        "notAfter": {
          "type": "string",
          "allOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            {
              "format": "date-time"
            }
          ]
        }
      }
    },
    "keyFingerprint": {
      "$ref": "#/$defs/digest"
    },
    "grantSHA256": {
      "$ref": "#/$defs/digest"
    },
    "signatureCAS": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S+$"
    }
  }
}
