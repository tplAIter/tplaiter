{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tplaiter.dev/state-ledger-report/v1",
  "title": "tplaiter state-ledger report",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "projectID", "planSHA256", "receipt", "entries", "testOutcomes", "result", "reportSHA256"],
  "properties": {
    "apiVersion": {"const": "tplaiter.dev/state-ledger-report/v1"},
    "projectID": {"type": "string", "minLength": 1},
    "planSHA256": {"$ref": "#/$defs/digest"},
    "receipt": {"$ref": "#/$defs/receipt"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "beforeSHA256", "afterSHA256", "action", "retention"],
        "properties": {
          "path": {"type": "string"},
          "beforeSHA256": {"$ref": "#/$defs/digest"},
          "afterSHA256": {"$ref": "#/$defs/digest"},
          "action": {"type": "string"},
          "retention": {"type": "string"}
        }
      }
    },
    "testOutcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed"],
        "properties": {"name": {"type": "string"}, "passed": {"type": "boolean"}}
      }
    },
    "result": {"enum": ["planned", "applied", "blocked", "unsafe"]},
    "reportSHA256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityId", "highestAcceptedSequence", "envelopePayloadSHA256", "revocationEpoch", "checkpointDigest", "treeSize", "journalStatus", "journalDigest", "backend", "protection", "backendProtected"],
      "properties": {
        "authorityId": {"type": "string", "minLength": 1},
        "highestAcceptedSequence": {"type": "integer", "minimum": 1},
        "envelopePayloadSHA256": {"$ref": "#/$defs/digest"},
        "revocationEpoch": {"type": "integer", "minimum": 0},
        "checkpointDigest": {"$ref": "#/$defs/digest"},
        "treeSize": {"type": "integer", "minimum": 1},
        "journalStatus": {"const": "complete"},
        "journalDigest": {"$ref": "#/$defs/digest"},
        "backend": {"type": "string", "minLength": 1},
        "protection": {"type": "string", "minLength": 1},
        "backendProtected": {"const": true}
      }
    }
  }
}
