{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tplaiter.dev/schema/template-discovery-metadata.v1.schema.json",
  "description": "Separate discovery companion outside existing closed source packs. Raw UTF8 document <=65536 bytes. JSONSchema maxLength counts Unicode characters; DecodeMetadata additionally enforces UTF8 byte limits for every field, exact required fields, no null or duplicate/unknown fields. No trust or installation authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "candidatePin",
    "metadata"
  ],
  "properties": {
    "apiVersion": {
      "const": "tplaiter.dev/template-discovery-metadata/v1"
    },
    "candidatePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceID",
        "revision",
        "contentSHA256"
      ],
      "properties": {
        "sourceID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "contentSHA256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "description",
        "labels",
        "candidateKind",
        "readiness",
        "useCases",
        "blocks",
        "skills"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "labels": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "minItems": 1
          },
          "minProperties": 1,
          "required": [
            "tags"
          ],
          "properties": {
            "tags": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "\\S"
              }
            }
          }
        },
        "candidateKind": {
          "enum": [
            "template",
            "installable-block",
            "context",
            "documentation-recipe",
            "test-fixture",
            "skill",
            "unknown"
          ]
        },
        "readiness": {
          "enum": [
            "ready",
            "experimental",
            "planned",
            "deprecated",
            "unknown"
          ]
        },
        "useCases": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "blocks": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "sourcePin",
              "candidateKind",
              "readiness"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "sourcePin": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sourceID",
                  "revision",
                  "contentSHA256"
                ],
                "properties": {
                  "sourceID": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "contentSHA256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              },
              "candidateKind": {
                "enum": [
                  "template",
                  "installable-block",
                  "context",
                  "documentation-recipe",
                  "test-fixture",
                  "skill",
                  "unknown"
                ]
              },
              "readiness": {
                "enum": [
                  "ready",
                  "experimental",
                  "planned",
                  "deprecated",
                  "unknown"
                ]
              }
            }
          }
        },
        "skills": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "sourcePin",
              "candidateKind",
              "readiness"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "sourcePin": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sourceID",
                  "revision",
                  "contentSHA256"
                ],
                "properties": {
                  "sourceID": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "contentSHA256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              },
              "candidateKind": {
                "enum": [
                  "template",
                  "installable-block",
                  "context",
                  "documentation-recipe",
                  "test-fixture",
                  "skill",
                  "unknown"
                ]
              },
              "readiness": {
                "enum": [
                  "ready",
                  "experimental",
                  "planned",
                  "deprecated",
                  "unknown"
                ]
              }
            }
          }
        }
      }
    }
  }
}
