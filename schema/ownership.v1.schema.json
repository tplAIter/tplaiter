{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tplaiter.dev/ownership/v1",
  "title": "tplaiter ownership ledger (.tplaiter/ownership.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {"const": 1},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "mode": {"type": "integer", "minimum": 0, "maximum": 511},
          "kind": {"enum": ["file", "symlink"]},
          "target": {"type": "string", "minLength": 1}
        }
      }
    },
    "tombstones": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "reason": {"enum": ["exclude", "skipIfExists", "tombstone"]}
        }
      }
    }
  }
}
