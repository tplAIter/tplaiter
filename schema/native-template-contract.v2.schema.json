{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tplaiter.dev/schema/native-template-contract.v2.schema.json",
  "description": "Closed v2 data contract. The compiled parser also enforces byte limits, lexical safe-integer parameters, sorted unique aliases and parameters, exact manifest bytes, requestedRef equality, portable paths and source identity uniqueness. Runtime admission authenticates source relationships; schema validity grants no authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "manifestPath",
    "manifestSHA256",
    "dependencies"
  ],
  "properties": {
    "apiVersion": {
      "const": "tplaiter.dev/native-template-contract/v2"
    },
    "kind": {
      "const": "NativeTemplate"
    },
    "manifestPath": {
      "const": "template.manifest.yaml"
    },
    "manifestSHA256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "dependencies": {
      "type": "array",
      "maxItems": 31,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias",
          "origin",
          "templatePath",
          "commitAlgorithm",
          "commit",
          "treeDigest",
          "contractDigest"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
          },
          "origin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\u0000\\r\\n]+$"
          },
          "templatePath": {
            "anyOf": [
              {
                "const": "."
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\\\\u0000\\r\\n]+$",
                "description": "The compiled parser additionally enforces fs.ValidPath and the existing portable path contract."
              }
            ]
          },
          "commitAlgorithm": {
            "enum": [
              "sha1",
              "sha256"
            ]
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
          },
          "treeDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "contractDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "commitAlgorithm": {
                  "const": "sha1"
                }
              }
            },
            "then": {
              "properties": {
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "commitAlgorithm": {
                  "const": "sha256"
                }
              }
            },
            "then": {
              "properties": {
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        ]
      }
    }
  }
}
