{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tplaiter.dev/bootstrap-descriptor/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "profile",
    "authorityId",
    "anchors",
    "threshold",
    "allowedPolicyOrigins",
    "publisherScopes",
    "descriptorSHA256"
  ],
  "properties": {
    "apiVersion": {
      "const": "tplaiter.dev/bootstrap-descriptor/v1"
    },
    "profile": {
      "enum": [
        "oss",
        "organization"
      ]
    },
    "authorityId": {
      "type": "string",
      "pattern": "^\\S{1,256}$"
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/anchor"
      },
      "uniqueItems": true
    },
    "threshold": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "allowedPolicyOrigins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/origin"
      },
      "uniqueItems": true
    },
    "publisherScopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/scope"
      },
      "uniqueItems": true
    },
    "descriptorSHA256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "publicKeyBase64"
      ],
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "publicKeyBase64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyOrigin",
        "issuer",
        "sourceOrigin",
        "templatePath",
        "predicate",
        "usage"
      ],
      "properties": {
        "policyOrigin": {
          "$ref": "#/$defs/origin"
        },
        "issuer": {
          "type": "string",
          "pattern": "^\\S{1,256}$"
        },
        "sourceOrigin": {
          "$ref": "#/$defs/origin"
        },
        "templatePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?:\\.|[^/\\\\:]+(?:/[^/\\\\:]+)*)$",
          "not": {
            "anyOf": [
              {
                "pattern": "^\\.\\.$"
              },
              {
                "pattern": "(?:^|/)\\.{1,2}/"
              },
              {
                "pattern": "/\\.{1,2}$"
              }
            ]
          }
        },
        "predicate": {
          "$ref": "#/$defs/origin"
        },
        "usage": {
          "const": "template-source"
        }
      }
    },
    "origin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[a-z][a-z0-9+.-]*://[a-z0-9.-]+(?:/[^\\s?#\\\\]*)?$",
      "not": {
        "anyOf": [
          {
            "pattern": "://[^/]+/[^?]*//"
          },
          {
            "pattern": "%2[fF]|%5[bB]|%2[eE]"
          },
          {
            "pattern": "://[^/]+/.*(?:/\\.|/\\.\\.)"
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "anchors": {
            "minItems": 1,
            "maxItems": 1
          }
        }
      },
      "then": {
        "properties": {
          "threshold": {
            "maximum": 1
          }
        }
      }
    },
