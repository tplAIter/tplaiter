{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tplaiter.dev/schema/execution-policy.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "policyId",
    "profile",
    "minimumProfile",
    "validity",
    "principals",
    "issuerPrincipals",
    "sourceRules",
    "approvers",
    "allowInvocationHuman",
    "maxTimeoutMillis",
    "policySHA256"
  ],
  "properties": {
    "apiVersion": {
      "const": "tplaiter.dev/execution-policy/v1"
    },
    "policyId": {
      "$ref": "#/$defs/token"
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "minimumProfile": {
      "$ref": "#/$defs/profile"
    },
    "validity": {
      "$ref": "#/$defs/validity"
    },
    "principals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/principal"
      }
    },
    "issuerPrincipals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/issuerPrincipal"
      }
    },
    "sourceRules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/sourceRule"
      }
    },
    "approvers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/approver"
      }
    },
    "allowInvocationHuman": {
      "type": "boolean"
    },
    "maxTimeoutMillis": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "policySHA256": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S+$"
    },
    "principalID": {
      "type": "string",
      "pattern": "^principal:[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "profile": {
      "enum": [
        "oss",
        "organization",
        "development"
      ]
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notBefore",
        "notAfter"
      ],
      "properties": {
        "notBefore": {
          "type": "string",
          "allOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            {
              "format": "date-time"
            }
          ]
        },
        "notAfter": {
          "type": "string",
          "allOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            {
              "format": "date-time"
            }
          ]
        }
      }
    },
    "path": {
      "oneOf": [
        {
          "const": "."
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^/\\\\:\\p{C}]+(?:/[^/\\\\:\\p{C}]+)*$",
          "not": {
            "pattern": "(^|/)\\.\\.?($|/)"
          }
        }
      ]
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/principalID"
        }
      }
    },
    "issuerPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "principalID"
      ],
      "properties": {
        "issuer": {
          "$ref": "#/$defs/token"
        },
        "principalID": {
          "$ref": "#/$defs/principalID"
        }
      }
    },
    "sourceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyOrigin",
        "issuer",
        "origin",
        "templatePath",
        "predicate",
        "format"
      ],
      "properties": {
        "policyOrigin": {
          "$ref": "#/$defs/token"
        },
        "issuer": {
          "$ref": "#/$defs/token"
        },
        "origin": {
          "$ref": "#/$defs/token"
        },
        "templatePath": {
          "$ref": "#/$defs/path"
        },
        "predicate": {
          "$ref": "#/$defs/token"
        },
        "format": {
          "const": "tplaiter-publisher-statement-v1"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectID",
        "operationScope",
        "actionKind",
        "origin",
        "templatePath"
      ],
      "properties": {
        "projectID": {
          "$ref": "#/$defs/token"
        },
        "operationScope": {
          "enum": [
            "new",
            "link",
            "update",
            "run",
            "gen",
            "tool-install",
            "migration"
          ]
        },
        "actionKind": {
          "enum": [
            "hook",
            "command",
            "shell",
            "ansible",
            "codegen",
            "formatter",
            "tool-install",
            "migration"
          ]
        },
        "origin": {
          "$ref": "#/$defs/token"
        },
        "templatePath": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "principalID",
        "identityClass",
        "keyFingerprint",
        "publicKeyBase64",
        "validity",
        "scopes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "principalID": {
          "$ref": "#/$defs/principalID"
        },
        "identityClass": {
          "enum": [
            "operator",
            "automation"
          ]
        },
        "keyFingerprint": {
          "$ref": "#/$defs/digest"
        },
        "publicKeyBase64": {
          "type": "string",
          "minLength": 44,
          "maxLength": 44,
          "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$"
        },
        "validity": {
          "$ref": "#/$defs/validity"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/scope"
          }
        }
      }
    }
  }
}
