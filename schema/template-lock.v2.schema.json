{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tplaiter.dev/template-lock/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "trustProfile", "rootLockSHA256", "dependencies", "lockSHA256"],
  "properties": {
    "apiVersion": {"const": "tplaiter.dev/template-lock/v2"},
    "kind": {"const": "DependencyExportLock"},
    "trustProfile": {"$ref": "#/$defs/profile"},
    "rootLockSHA256": {"$ref": "#/$defs/digest"},
    "dependencies": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/subject"}},
    "lockSHA256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "profile": {"type":"object","additionalProperties":false,"required":["apiVersion","id","definitionVersion","configSHA256","policySHA256","authoritySHA256","assurance","evidenceClass"],"properties":{"apiVersion":{"const":"tplaiter.dev/trust-profile-binding/v1"},"id":{"enum":["oss","development","organization"]},"definitionVersion":{"const":1},"configSHA256":{"$ref":"#/$defs/digest"},"policySHA256":{"$ref":"#/$defs/digest"},"authoritySHA256":{"$ref":"#/$defs/digest"},"assurance":{"enum":["publisher-verified","development-unverified","organization-protected"]},"evidenceClass":{"enum":["production","simulated"]}},"allOf":[{"if":{"properties":{"id":{"const":"oss"}}},"then":{"properties":{"assurance":{"const":"publisher-verified"}}}},{"if":{"properties":{"id":{"const":"development"}}},"then":{"properties":{"assurance":{"const":"development-unverified"}}}},{"if":{"properties":{"id":{"const":"organization"}}},"then":{"properties":{"assurance":{"const":"organization-protected"},"evidenceClass":{"const":"production"}}}}]},
    "subject": {"type":"object","additionalProperties":false,"required":["origin","templatePath","requestedRef","commit","treeSHA256","contractSHA256","statementCAS","signatureCAS","keyFingerprint","checkpointCAS","inclusionProofCAS"],"properties":{"origin":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$"},"templatePath":{"type":"string","minLength":1,"pattern":"^[^/\\\\].*$","not":{"pattern":"[\u0000-\u001F\u007F]|\\.\\."}},"requestedRef":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$"},"commit":{"type":"string","pattern":"^[0-9a-f]{40}([0-9a-f]{24})?$"},"treeSHA256":{"$ref":"#/$defs/digest"},"contractSHA256":{"$ref":"#/$defs/digest"},"statementCAS":{"$ref":"#/$defs/digest"},"signatureCAS":{"$ref":"#/$defs/digest"},"keyFingerprint":{"$ref":"#/$defs/digest"},"checkpointCAS":{"$ref":"#/$defs/digest"},"inclusionProofCAS":{"$ref":"#/$defs/digest"}}}
  }
}
