{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://tplaiter.dev/schema/typescript-comments.v1.schema.json","type":"object","additionalProperties":false,"required":["apiVersion","language","path","inputSHA256","providerSHA256","comments"],"properties":{"apiVersion":{"const":"tplaiter.dev/typescript-comments/v1"},"language":{"enum":["typescript","tsx"]},"path":{"type":"string","minLength":1,"maxLength":1024,"pattern":"^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$","not":{"pattern":"(^|/)\\.\\.?(/|$)"}},"inputSHA256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"providerSHA256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"comments":{"type":"array","maxItems":65536,"items":{"type":"object","additionalProperties":false,"required":["kind","startByte","endByte"],"properties":{"kind":{"enum":["line","block"]},"startByte":{"type":"integer","minimum":0},"endByte":{"type":"integer","minimum":1}}}}},"allOf":[{"if":{"properties":{"language":{"const":"tsx"}}},"then":{"properties":{"path":{"pattern":"\\.tsx$"}}}},{"if":{"properties":{"language":{"const":"typescript"}}},"then":{"properties":{"path":{"pattern":"\\.(ts|mts|cts)$"}}}}]}
