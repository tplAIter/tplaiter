{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tplaiter.dev/source-local-export-index/v1",
  "title": "Source local authored export index (inert metadata)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "exports"
  ],
  "properties": {
    "apiVersion": {
      "const": "tplaiter.dev/source-local-export-index/v1"
    },
    "exports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "name",
        "version",
        "contentDigest",
        "requires",
        "parameters",
        "toolDigest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
        },
        "domain": {
          "enum": [
            "block",
            "skill",
            "approach",
            "package"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
        },
        "version": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "requires": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "parameters": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "toolDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "contractDigest",
        "compatibleRange"
      ],
      "properties": {
        "selector": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}\\.(block|skill|approach|package)\\.[A-Za-z][A-Za-z0-9_-]{0,127}$"
        },
        "contractDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "compatibleRange": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
        },
        "value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          ],
          "description": "Wire parser additionally requires plain canonical-safe integer lexemes; -0, fraction and exponent spellings refuse. JSON Schema alone cannot express number lexemes."
        }
      }
    }
  }
}
