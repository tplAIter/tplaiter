{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "tplaiter.dev/local-provider-registration/v1"
    },
    "kind": {
      "const": "LocalProviderRegistration"
    },
    "registrationID": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\u0000\t\r\n /\\\\]+$",
      "not": {
        "pattern": "[\u0000\t\r\n /\\\\]"
      },
      "maxLength": 64,
      "$comment": "maxLength counts Unicode code points. Installed admission additionally requires valid UTF-8 and at most 64 UTF-8 bytes; e.g. 33 two-byte characters satisfy this scalar schema but are refused by admission. Schema acceptance is not connection authority."
    },
    "installationID": {
      "type": "string"
    },
    "projectKeys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\u0000\t\r\n /\\\\]+$",
        "not": {
          "pattern": "[\u0000\t\r\n /\\\\]"
        },
        "maxLength": 64,
        "$comment": "maxLength counts Unicode code points. Installed admission additionally requires valid UTF-8 and at most 64 UTF-8 bytes; e.g. 33 two-byte characters satisfy this scalar schema but are refused by admission. Schema acceptance is not connection authority."
      }
    },
    "protocol": {
      "const": "local-provider.session/v1"
    },
    "qualification": {
      "const": "local-untrusted-observed"
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unix"
        },
        "socketPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 103,
          "pattern": "^/"
        },
        "ownerUID": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "kind",
        "socketPath",
        "ownerUID"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frameBytes": {
          "type": "integer",
          "minimum": 512,
          "maximum": 32768
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 512,
          "maximum": 2097152
        },
        "pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "sourceBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "deadlineMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        }
      },
      "required": [
        "frameBytes",
        "totalBytes",
        "pages",
        "sourceBytes",
        "deadlineMs"
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "registrationID",
    "installationID",
    "projectKeys",
    "protocol",
    "qualification",
    "endpoint",
    "limits"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tplaiter.dev/local-provider-registration/v1"
}
